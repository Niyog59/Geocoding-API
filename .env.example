# Copy to .env for local development. Never commit .env.

APP_ENV=development
REDIS_URL=redis://localhost:6379/0

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_SECRET=

# Exact origins allowed to call the API from a browser (comma-separated).
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Provider. For local work without a real key, run the fake provider
# (uvicorn tools.fake_upstream:app --port 9100) and use:
#   PROVIDER=geoapify  GEOAPIFY_API_KEY=local-fake  GEOAPIFY_BASE_URL=http://localhost:9100
PROVIDER=geoapify
GEOAPIFY_API_KEY=
# GEOAPIFY_BASE_URL=https://api.geoapify.com

# Or your own Nominatim instance (never nominatim.openstreetmap.org):
# PROVIDER=nominatim
# NOMINATIM_BASE_URL=http://localhost:8080
# NOMINATIM_USER_AGENT=my-geocoder/1.0 (you@example.com)

# Limits (defaults shown). The provider budget must stay below your provider plan's quota.
# PROVIDER_DAILY_BUDGET=2000
# PROVIDER_RATE_PER_SECOND=4
# DEMO_RATE_PER_MINUTE=10
# DEMO_DAILY_PER_IP=100
# DEMO_DAILY_TOTAL=1000
# DEFAULT_KEY_RATE_PER_MINUTE=60
# DEFAULT_KEY_DAILY_LIMIT=1000

# Behind a proxy that appends the client address to X-Forwarded-For:
# CLIENT_IP_SOURCE=x-forwarded-for
# TRUSTED_PROXY_COUNT=1
